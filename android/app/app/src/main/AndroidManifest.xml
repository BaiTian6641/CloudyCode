<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Only granted to a preinstalled/partner build (signature|preinstalled). -->
    <uses-permission android:name="com.android.virtualization.terminal.permission.MANAGE_TERMINAL" />

    <!-- Android 11+ package visibility: resolve the Googlebook Terminal
         command-intent endpoint (android-terminal://start). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="android-terminal" />
        </intent>
    </queries>

    <application
        android:name=".GbCodeApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Cloudy"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:resizeableActivity="true">
        <activity
            android:name=".ui.StartupActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="true"
            android:launchMode="singleTask" />
        <activity
            android:name=".ui.UsbInventoryActivity"
            android:exported="true" />
        <activity
            android:name=".ui.X11AppsActivity"
            android:exported="false"
            android:label="Cloudy X11" />
        <activity
            android:name=".ui.X11Activity"
            android:exported="false"
            android:launchMode="standard"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:label="Cloudy X11"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />
        <activity-alias
            android:name=".ui.X11Launcher"
            android:targetActivity=".ui.X11AppsActivity"
            android:exported="true"
            android:label="Cloudy X11"
            android:icon="@mipmap/ic_launcher_x11">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <service
            android:name=".SerialBridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".UsbIpService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <activity
            android:name=".ui.WorkbenchActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />
    </application>

</manifest>
