<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only granted to a preinstalled/partner build (signature|preinstalled). -->
    <uses-permission android:name="com.android.virtualization.terminal.permission.MANAGE_TERMINAL" />

    <!-- Android 11+ package visibility: resolve the Googlebook Terminal
         command-intent endpoint (android-terminal://start). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="android-terminal" />
        </intent>
    </queries>

    <application
        android:name=".GbCodeApp"
        android:label="GBCode"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@android:drawable/ic_menu_edit"
        android:supportsRtl="true"
        android:resizeableActivity="true">
        <activity
            android:name=".ui.StartupActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="true"
            android:launchMode="singleTask" />
        <activity
            android:name=".ui.WorkbenchActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />
    </application>

</manifest>
