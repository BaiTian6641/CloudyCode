<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_canvas">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/Cloudy.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Advanced setup" />

        <TextView
            style="@style/Cloudy.Metadata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pair with an existing Cloudy Code daemon (reh-web backend)" />

        <TextView
            style="@style/Cloudy.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start the daemon with --enroll in the Linux environment, then paste the printed address and one-time secret. Compare the server fingerprint before continuing." />

        <TextView style="@style/Cloudy.Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Daemon address" />
        <EditText
            android:id="@+id/daemonField"
            style="@style/Cloudy.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:background="@drawable/bg_field"
            android:padding="12dp" android:singleLine="true"
            android:hint="http://127.0.0.1:9123" />

        <TextView style="@style/Cloudy.Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Workbench URL" />
        <EditText
            android:id="@+id/workbenchField"
            style="@style/Cloudy.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:background="@drawable/bg_field"
            android:padding="12dp" android:singleLine="true"
            android:hint="http://127.0.0.1:8085" />

        <TextView style="@style/Cloudy.Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="One-time pairing secret" />
        <EditText
            android:id="@+id/secretField"
            style="@style/Cloudy.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:background="@drawable/bg_field"
            android:padding="12dp" android:singleLine="true"
            android:inputType="textPassword" />

        <TextView style="@style/Cloudy.Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Backend password (optional)" />
        <EditText
            android:id="@+id/passwordField"
            style="@style/Cloudy.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:background="@drawable/bg_field"
            android:padding="12dp" android:singleLine="true"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/pairButton"
            style="@style/Cloudy.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pair and connect" />

        <Button
            android:id="@+id/reconnectButton"
            style="@style/Cloudy.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reconnect saved identity" />

        <Button
            android:id="@+id/offlineButton"
            style="@style/Cloudy.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open workbench without a guest" />

        <TextView style="@style/Cloudy.Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Activity" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_log"
            android:padding="12dp">

            <TextView
                android:id="@+id/logView"
                style="@style/Cloudy.Code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cw_text_primary" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
