<?xml version="1.0" encoding="utf-8"?>
<!-- Cloudy connection surface: replaces the WebView error page. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_canvas"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/overlayContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <TextView
                style="@style/Cloudy.Metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Linux workspace" />

            <TextView
                android:id="@+id/overlayTitle"
                style="@style/Cloudy.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Reconnecting…" />

            <ProgressBar
                android:id="@+id/overlayProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:progressTint="@color/cw_primary"
                android:progressBackgroundTint="@color/cw_surface_raised" />

            <TextView
                android:id="@+id/overlayDetail"
                style="@style/Cloudy.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:id="@+id/overlayActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/retryNow"
                    style="@style/Cloudy.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Retry now" />

                <Button
                    android:id="@+id/openTerminal"
                    style="@style/Cloudy.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Open Terminal" />

                <Button
                    android:id="@+id/copyCommand"
                    style="@style/Cloudy.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Copy setup command" />

                <Button
                    android:id="@+id/advancedSetup"
                    style="@style/Cloudy.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Advanced setup" />

                <Button
                    android:id="@+id/offlineWorkbench"
                    style="@style/Cloudy.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Continue offline" />
            </LinearLayout>

            <Button
                android:id="@+id/showOptions"
                style="@style/Cloudy.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Show options" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
