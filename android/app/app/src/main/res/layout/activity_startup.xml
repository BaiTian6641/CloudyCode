<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_canvas">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/pageTitle"
                style="@style/Cloudy.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                style="@style/Cloudy.Metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/startup_subtitle" />

            <TextView
                android:id="@+id/statusText"
                style="@style/Cloudy.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Preparing the Linux environment…" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:progressTint="@color/cw_primary"
                android:progressBackgroundTint="@color/cw_surface_raised" />

            <TextView
                android:id="@+id/detail"
                style="@style/Cloudy.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:id="@+id/setupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    style="@style/Cloudy.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/startup_setup_title" />

                <TextView
                    style="@style/Cloudy.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Run this once in the Terminal. It installs code-server in the Linux VM and starts it on port 8080; later launches connect automatically." />

                <TextView
                    android:id="@+id/commandBlock"
                    style="@style/Cloudy.Code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_code_block"
                    android:padding="16dp"
                    android:textIsSelectable="true" />

                <Button
                    android:id="@+id/copySetup"
                    style="@style/Cloudy.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/startup_copy_command" />

                <Button
                    android:id="@+id/openTerminal"
                    style="@style/Cloudy.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/startup_open_terminal" />

                <Button
                    android:id="@+id/retry"
                    style="@style/Cloudy.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/startup_retry" />
            </LinearLayout>

            <Button
                android:id="@+id/offline"
                style="@style/Cloudy.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/startup_offline" />

            <Button
                android:id="@+id/advanced"
                style="@style/Cloudy.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/startup_advanced" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
