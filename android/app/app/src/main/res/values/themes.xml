<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cloudy shell theme: no app title bar; the Android system caption is the
         only window chrome (design/layout.md: never recreate system controls). -->
    <style name="Theme.Cloudy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cw_canvas</item>
        <item name="android:colorAccent">@color/cw_primary</item>
        <item name="android:textColorPrimary">@color/cw_text_primary</item>
        <item name="android:textColorSecondary">@color/cw_text_secondary</item>
        <item name="android:statusBarColor">@color/cw_canvas</item>
        <item name="android:navigationBarColor">@color/cw_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Cloudy.PageTitle" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/cw_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Cloudy.SectionTitle" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/cw_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Cloudy.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/cw_text_primary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Cloudy.BodySecondary" parent="Cloudy.Body">
        <item name="android:textColor">@color/cw_text_secondary</item>
    </style>
    <style name="Cloudy.Label" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/cw_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Cloudy.Metadata" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/cw_text_secondary</item>
    </style>
    <style name="Cloudy.Code" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/cw_terminal_text</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- Buttons: filled primary, outline secondary, text tertiary (one filled
         action per task region). -->
    <style name="Cloudy.Button.Primary" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/cw_on_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Cloudy.Button.Secondary" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/cw_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Cloudy.Button.Text" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/cw_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
