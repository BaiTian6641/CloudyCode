# Local credentials and release signing material
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pfx
*.key
local.properties
/android/local.properties

# Android / Gradle / Kotlin build output
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
**/build/
*.apk
*.aab
*.apks

# Guest / extension build output and dependency caches
**/target/
**/node_modules/
**/dist/
**/.venv/
**/__pycache__/
*.py[cod]
*.vsix

# ADR-0006: generated web workbench assets (tools/release/package-web-assets.sh).
# The generated manifest copy under android/app/asset-manifest/ is tracked.
/android/app/app/src/main/assets/web/

# Re-creatable upstream working copies; keep pins and patches tracked
/upstream/checkouts/

# Machine-local IDE metadata and temporary output
.idea/
.DS_Store
*.swp
*.swo
*.log
/tmp/

# Private device evidence; publish only reviewed, redacted records
/docs/evidence/private/

# Probe run artifacts (curated copies live in docs/evidence/)
/tools/echo-server/results.jsonl
/android/probes/**/local.properties

# Generated pinned-engine JNI artifact; rebuild with
# android/cloudy-x11 app preBuild or tools/device/build-x11-jni.sh.
/android/cloudy-x11/app/src/main/jniLibs/

# Local/CI staged APK deliverables (uploaded from Actions, never tracked).
/ci-dist/
